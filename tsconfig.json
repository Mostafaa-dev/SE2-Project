{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "types": ["node", "jest"],
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
